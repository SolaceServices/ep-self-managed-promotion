! Create Message Spool: "sandbox"
message-spool message-vpn "sandbox"
  max-spool-usage 50000
  max-transacted-sessions 500
  max-transactions 2500
  max-endpoints 250
  max-egress-flows 250
  max-ingress-flows 250
  event spool-usage thresholds set-percentage 80 clear-percentage 60
  event transacted-sessions thresholds set-percentage 80 clear-percentage 60
  event transactions thresholds set-percentage 80 clear-percentage 60
  event endpoints thresholds set-percentage 80 clear-percentage 60
  event egress-flows thresholds set-percentage 80 clear-percentage 60
  event ingress-flows thresholds set-percentage 80 clear-percentage 60
  exit

! Create MQTT Sessions: 

! Create MQTT Retain Cache: 

! Create Endpoints: "sandbox"
message-spool message-vpn "sandbox"
  create queue "#DEAD_MSG_QUEUE" external is-well-known
    access-type "exclusive"
    max-bind-count 1000
    max-delivered-unacked-msgs-per-flow 10000
    max-message-size 10000000
    max-spool-usage 5000
    no delivery-count
    delivery-delay 0
    redelivery-delay initial-interval 1000
    redelivery-delay max-interval 64000
    redelivery-delay multiplier "2.00"
    redelivery-delay shutdown
    reject-msg-to-sender-on-discard
    reject-low-priority-msg-limit 0
    event bind-count thresholds set-percentage 80 clear-percentage 60
    event reject-low-priority-msg-limit thresholds set-percentage 80 clear-percentage 60
    event spool-usage thresholds set-percentage 25 clear-percentage 18
    owner "sdkperf"
    no dead-message-queue
    no permission
    no respect-message-priority
    partition count 0
    partition rebalance delay 5
    partition rebalance max-handoff-time 3
    no shutdown ingress
    no shutdown egress
    exit
  create queue "Q.CLIENT_CONNECTION" is-well-known
    access-type "exclusive"
    max-bind-count 1000
    max-delivered-unacked-msgs-per-flow 10000
    max-message-size 10000000
    max-spool-usage 5000
    redelivery
    max-redelivery 0
    no delivery-count
    delivery-delay 0
    redelivery-delay initial-interval 1000
    redelivery-delay max-interval 64000
    redelivery-delay multiplier "2.00"
    redelivery-delay shutdown
    reject-msg-to-sender-on-discard
    reject-low-priority-msg-limit 0
    event bind-count thresholds set-percentage 80 clear-percentage 60
    event reject-low-priority-msg-limit thresholds set-percentage 80 clear-percentage 60
    event spool-usage thresholds set-percentage 25 clear-percentage 18
    owner "sdkperf_receiver"
    dead-message-queue "#DEAD_MSG_QUEUE"
    permission all consume
    no respect-message-priority
    no respect-ttl
    no max-ttl
    no reject-low-priority-msg
    partition count 0
    partition rebalance delay 5
    partition rebalance max-handoff-time 3
    subscription topic "#LOG/INFO/CLIENT/*/CLIENT_CLIENT_CONNECT/>" 
    subscription topic "#LOG/INFO/CLIENT/*/CLIENT_CLIENT_DISCONNECT/>" 
    shutdown ingress
    no shutdown egress
    exit
  create queue "Q.HCM_EVENT_SN" is-well-known
    access-type "exclusive"
    max-bind-count 1000
    max-delivered-unacked-msgs-per-flow 10000
    max-message-size 10000000
    max-spool-usage 5000
    redelivery
    max-redelivery 20
    no delivery-count
    delivery-delay 0
    redelivery-delay initial-interval 1000
    redelivery-delay max-interval 64000
    redelivery-delay multiplier "2.00"
    redelivery-delay shutdown
    reject-msg-to-sender-on-discard
    reject-low-priority-msg-limit 0
    event bind-count thresholds set-percentage 80 clear-percentage 60
    event reject-low-priority-msg-limit thresholds set-percentage 80 clear-percentage 60
    event spool-usage thresholds set-percentage 25 clear-percentage 18
    owner "#rdp/MOODYS_POC"
    dead-message-queue "Q.HCM_EVENT_SN_DMQ"
    permission all consume
    no respect-message-priority
    no respect-ttl
    no max-ttl
    no reject-low-priority-msg
    partition count 0
    partition rebalance delay 5
    partition rebalance max-handoff-time 3
    subscription topic "moodys/hcm/ratings/worker/demo/*" 
    no shutdown ingress
    no shutdown egress
    exit
