! Create Replay Log: "sandbox"
message-spool message-vpn "sandbox"
  create replay-log "defaultLog"
    max-spool-usage 323
    no shutdown ingress
    no shutdown egress
    topic-filter
      no shutdown
      exit
    topic-filter
      create subscription "topic/demo/replay"
        exit
      exit
    exit
  exit

! Create Oauth Providers: "sandbox"

! Create Oauth Profiles: "sandbox"
message-vpn "sandbox"
  authentication
    oauth
      create profile "t"
        authorization-groups-claim-name "groups"
        authorization-groups-claim-string-format "single"
        client
          required-type "JWT"
          validate-type
          exit
        client-id ""
        aes-client-secret "********"
        disconnect-on-token-expiration
        endpoints
          discovery ""
          discovery-refresh-interval 86400
          introspection ""
          introspection-timeout 1
          jwks ""
          jwks-refresh-interval 86400
          userinfo ""
          userinfo-timeout 1
          exit
        issuer ""
        proxy ""
        no mqtt-username-validate
        oauth-role "client"
        resource-server
          parse-access-token
          required-audience ""
          required-issuer ""
          required-scope ""
          required-type "at+jwt"
          validate-audience
          validate-issuer
          validate-scope
          validate-type
          exit
        no shutdown
        username-claim-name "sub"
        exit
      exit
    exit
  exit

! Create Queue Templates: "sandbox"

! Create Topic Endpoint Templates: "sandbox"

! Enable Message Vpn: "sandbox"
message-vpn "sandbox"
  no shutdown
  replication
    state "active"
    no shutdown
    exit
  exit

